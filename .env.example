# Tracking Packages — environment variables
# Copy to .env for local docker-compose (Portainer can set these in the UI)

PORT=4200
DATA_DIR=/data/tracking-packages

# Optional API keys for real-time live tracking.
# Without keys the app falls back to reading the public carrier tracking pages.
API_TOKEN_17TRACK=
TRACK17_TOKEN=
TRACKINGMORE_API_KEY=
FEDEX_API_KEY=
FEDEX_API_SECRET=
FEDEX_API_URL=https://apis.fedex.com
UPS_CLIENT_ID=
UPS_CLIENT_SECRET=
DHL_API_KEY=
